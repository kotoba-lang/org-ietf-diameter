;; Diameter (RFC 6733) is a flat header + AVP TLV wire format, like its
;; predecessor RADIUS — not ASN.1, so there is no BER/DER layer to reuse
;; from org-ietf-asn1 (see README's "Why there is no dependency on
;; org-ietf-asn1"). No cryptographic primitive is needed either: unlike
;; RADIUS, which needs MD5 for its own Authenticator/User-Password
;; obfuscation (org-ietf-radius's `radius.md5`), Diameter delegates
;; transport security entirely to TLS/DTLS (RFC 6733 §5.3, §13) and this
;; repo is a codec, not a transport — nothing here computes an
;; Authenticator-equivalent value.
{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
